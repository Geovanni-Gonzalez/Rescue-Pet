generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  VETERINARIAN
  VOLUNTEER
  ADOPTER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  BLOCKED
}

enum AnimalStatus {
  QUARANTINE
  AVAILABLE
  TREATMENT
  ADOPTED
  DECEASED
}

enum AdoptionRequestStatus {
  RECEIVED
  INTERVIEW
  VISIT
  APPROVED
  REJECTED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentType {
  ID_CARD
  ADDRESS_PROOF
}

enum ContractStatus {
  GENERATED
  SIGNED
}

enum VaccineStatus {
  PENDING
  COMPLETED
  POSTPONED
}

enum TaskType {
  HEALTH
  MEDICATION
  CLEANING
  FEEDING
  MAINTENANCE
}

enum TaskStatus {
  PENDING
  COMPLETED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                 String     @id @default(uuid())
  fullName           String
  email              String     @unique
  passwordHash       String
  phone              String?
  photoUrl           String?
  role               Role       @default(ADOPTER)
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  activationToken    String?    @unique
  resetToken         String?    @unique
  resetTokenExpiresAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relaciones
  animalsCreated       Animal[]              @relation("AnimalCreatedBy")
  statusHistoryChanges AnimalStatusHistory[]
  adoptionRequests     AdoptionRequest[]
  documents            AdopterDocument[]
  compatibilityTests   CompatibilityTest[]
  compatibilityScores  CompatibilityScore[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  clinicalEntries      ClinicalEntry[]
  galleryUploads       AnimalGallery[]
  taskCompletions      OperationalTask[]     @relation("TaskCompletedBy")
  tasksCreated         OperationalTask[]     @relation("TaskCreatedBy")
  interviewSlotsCreated InterviewSlot[]
}

model Animal {
  id                  String       @id @default(uuid())
  name                String
  species             String
  estimatedBreed      String?
  estimatedAge        Int?         // en meses
  size                String?
  status              AnimalStatus @default(QUARANTINE)
  mainPhotoUrl        String?
  rescueLocationText  String?
  rescueLatitude      Float?
  rescueLongitude     Float?
  publicProfileUrl    String?
  qrUrl               String?
  energyLevel         String?      // LOW, MEDIUM, HIGH
  spaceNeed           String?      // SMALL, MEDIUM, LARGE
  goodWithChildren    Boolean      @default(false)
  goodWithPets        Boolean      @default(false)
  createdByUserId     String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relaciones
  createdBy           User?                @relation("AnimalCreatedBy", fields: [createdByUserId], references: [id])
  gallery             AnimalGallery[]
  statusHistory       AnimalStatusHistory[]
  clinicalRecord      ClinicalRecord?
  adoptionRequests    AdoptionRequest[]
  compatibilityScores CompatibilityScore[]
  operationalTasks    OperationalTask[]
  vaccines            Vaccine[]
}

model AnimalGallery {
  id               String   @id @default(uuid())
  animalId         String
  fileUrl          String
  fileType         String   // image/jpeg, image/png, image/webp
  isMain           Boolean  @default(false)
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  animal     Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedByUserId], references: [id])
}

model AnimalStatusHistory {
  id               String       @id @default(uuid())
  animalId         String
  previousStatus   AnimalStatus
  newStatus        AnimalStatus
  changedByUserId  String
  reason           String?
  createdAt        DateTime     @default(now())

  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedByUserId], references: [id])
}

// ─── Veterinaria ──────────────────────────────────────────────────────────────

model ClinicalRecord {
  id        String   @id @default(uuid())
  animalId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animal  Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade)
  entries ClinicalEntry[]
}

model ClinicalEntry {
  id               String   @id @default(uuid())
  clinicalRecordId String
  animalId         String
  veterinarianId   String
  datetime         DateTime
  diagnosis        String
  treatment        String
  medicine         String?
  dose             String?
  duration         String?
  observations     String?
  createdAt        DateTime @default(now())

  clinicalRecord ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
  veterinarian   User           @relation(fields: [veterinarianId], references: [id])

  vaccines Vaccine[]
}

model Vaccine {
  id              String        @id @default(uuid())
  animalId        String
  clinicalEntryId String?
  vaccineType     String
  appliedAt       DateTime
  nextDueAt       DateTime?
  status          VaccineStatus @default(PENDING)
  postponedTo     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  animal        Animal         @relation(fields: [animalId], references: [id], onDelete: Cascade)
  clinicalEntry ClinicalEntry? @relation(fields: [clinicalEntryId], references: [id])
}

// ─── Matchmaking ──────────────────────────────────────────────────────────────

model CompatibilityTest {
  id                 String   @id @default(uuid())
  adopterId          String   @unique
  housingType        String   // HOUSE, APARTMENT
  hasYard            Boolean  @default(false)
  childrenCount      Int      @default(0)
  hasOtherPets       Boolean  @default(false)
  dailyAvailableTime Int      // en horas
  allergies          String?
  experienceLevel    String   // NONE, BEGINNER, EXPERIENCED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  adopter User @relation(fields: [adopterId], references: [id])
}

model CompatibilityScore {
  id           String   @id @default(uuid())
  adopterId    String
  animalId     String
  scorePercentage Float   // de 0 a 100
  explanation  String?
  calculatedAt DateTime @default(now())

  adopter User   @relation(fields: [adopterId], references: [id])
  animal  Animal @relation(fields: [animalId], references: [id])

  @@unique([adopterId, animalId])
}

// ─── Adopción ─────────────────────────────────────────────────────────────────

model AdoptionRequest {
  id              String                @id @default(uuid())
  adopterId       String
  animalId        String
  status          AdoptionRequestStatus @default(RECEIVED)
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  adopter       User              @relation(fields: [adopterId], references: [id])
  animal        Animal            @relation(fields: [animalId], references: [id])
  documents     AdopterDocument[]
  contract      AdoptionContract?
  interviewSlot InterviewSlot?    @relation("SlotReservation")
}

model InterviewSlot {
  id                    String   @id @default(uuid())
  startsAt              DateTime
  endsAt                DateTime
  status                String   @default("available") // available, reserved, cancelled
  reservedByApplicationId String? @unique
  createdByAdminId      String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  createdBy   User             @relation(fields: [createdByAdminId], references: [id])
  application AdoptionRequest? @relation("SlotReservation", fields: [reservedByApplicationId], references: [id])
}

model AdopterDocument {
  id                String         @id @default(uuid())
  adopterId         String
  applicationId     String?
  documentType      DocumentType
  fileUrl           String
  fileName          String
  version           Int            @default(1)
  status            DocumentStatus @default(ACTIVE)
  uploadedAt        DateTime       @default(now())

  adopter      User             @relation(fields: [adopterId], references: [id])
  application  AdoptionRequest? @relation(fields: [applicationId], references: [id])
}

model AdoptionContract {
  id                String         @id @default(uuid())
  applicationId     String         @unique
  animalId          String?
  adopterId         String?
  pdfUrl            String?
  signedPdfUrl      String?
  signatureImageUrl String?
  status            ContractStatus @default(GENERATED)
  createdAt         DateTime       @default(now())
  signedAt          DateTime?

  application AdoptionRequest @relation(fields: [applicationId], references: [id])
}

// ─── Notificaciones ───────────────────────────────────────────────────────────

model Notification {
  id           String    @id @default(uuid())
  userId       String
  type         String    // INFO, WARNING, SUCCESS, ERROR
  title        String
  message      String
  resourceType String?
  resourceId   String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── Tareas operativas ────────────────────────────────────────────────────────

model OperationalTask {
  id            String     @id @default(uuid())
  animalId      String?
  type          TaskType
  assignedRole  String     // VETERINARIAN, VOLUNTEER
  scheduledAt   DateTime
  status        TaskStatus @default(PENDING)
  description   String?
  completedAt   DateTime?
  completedById String?
  comment       String?
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  animal      Animal? @relation(fields: [animalId], references: [id])
  completedBy User?   @relation("TaskCompletedBy", fields: [completedById], references: [id])
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id])
}

// ─── Auditoría ────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  entityType   String
  entityId     String
  metadataJson String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
