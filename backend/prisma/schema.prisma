generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─── Modelos ──────────────────────────────────────────────────────────────────
// SQL Server no soporta enum nativo en Prisma.
// Los campos de "enum" se almacenan como String con validación en la capa de aplicación.

model User {
  id                  String    @id @default(uuid())
  fullName            String
  email               String    @unique
  passwordHash        String
  phone               String?
  photoUrl            String?
  /// Valores: ADMIN | VETERINARIAN | VOLUNTEER | ADOPTER
  role                String    @default("ADOPTER")
  /// Valores: ACTIVE | INACTIVE | PENDING_VERIFICATION | BLOCKED
  status              String    @default("ACTIVE")
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?
  resetToken               String?   @unique
  resetTokenExpiresAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  animalsCreated        Animal[]              @relation("AnimalCreatedBy")
  statusHistoryChanges  AnimalStatusHistory[]
  locationHistoryChanges AnimalRescueLocationHistory[]
  adoptionRequests      AdoptionRequest[]
  documents             AdopterDocument[]
  compatibilityTests    CompatibilityTest[]
  compatibilityScores   CompatibilityScore[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  clinicalEntries       ClinicalEntry[]
  galleryUploads        AnimalGallery[]
  taskCompletions       OperationalTask[]     @relation("TaskCompletedBy")
  tasksCreated          OperationalTask[]     @relation("TaskCreatedBy")
  interviewSlotsCreated InterviewSlot[]
}

model Animal {
  id                 String   @id @default(uuid())
  name               String
  species            String
  estimatedBreed     String?
  estimatedAge       Int?
  size               String?
  /// Valores: QUARANTINE | AVAILABLE | TREATMENT | ADOPTED | DECEASED
  status             String   @default("QUARANTINE")
  mainPhotoUrl       String?
  rescueLocationText String?
  rescueLatitude     Float?
  rescueLongitude    Float?
  publicProfileUrl   String?
  qrUrl              String?
  energyLevel        String?
  spaceNeed          String?
  goodWithChildren   Boolean  @default(false)
  goodWithPets       Boolean  @default(false)
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relaciones
  createdBy           User?                        @relation("AnimalCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gallery             AnimalGallery[]
  statusHistory       AnimalStatusHistory[]
  locationHistory     AnimalRescueLocationHistory[]
  clinicalRecord      ClinicalRecord?
  adoptionRequests    AdoptionRequest[]
  compatibilityScores CompatibilityScore[]
  operationalTasks    OperationalTask[]
  vaccines            Vaccine[]
}

model AnimalGallery {
  id               String   @id @default(uuid())
  animalId         String
  fileUrl          String
  fileType         String
  isMain           Boolean  @default(false)
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  animal     Animal @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedBy User?  @relation(fields: [uploadedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AnimalStatusHistory {
  id              String   @id @default(uuid())
  animalId        String
  /// Valor anterior: QUARANTINE | AVAILABLE | TREATMENT | ADOPTED | DECEASED
  previousStatus  String
  /// Valor nuevo: QUARANTINE | AVAILABLE | TREATMENT | ADOPTED | DECEASED
  newStatus       String
  changedByUserId String
  reason          String?
  createdAt       DateTime @default(now())

  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedBy User   @relation(fields: [changedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Veterinaria ──────────────────────────────────────────────────────────────

model ClinicalRecord {
  id        String   @id @default(uuid())
  animalId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animal  Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entries ClinicalEntry[]
}

model ClinicalEntry {
  id               String   @id @default(uuid())
  clinicalRecordId String
  animalId         String
  veterinarianId   String
  datetime         DateTime
  diagnosis        String
  treatment        String
  medicine         String?
  dose             String?
  duration         String?
  observations     String?
  createdAt        DateTime @default(now())

  clinicalRecord ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  veterinarian   User           @relation(fields: [veterinarianId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  vaccines Vaccine[]
}

model Vaccine {
  id              String   @id @default(uuid())
  animalId        String
  clinicalEntryId String?
  vaccineType     String
  appliedAt       DateTime
  nextDueAt       DateTime?
  /// Valores: PENDING | COMPLETED | POSTPONED
  status          String    @default("PENDING")
  postponedTo     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  animal        Animal         @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinicalEntry ClinicalEntry? @relation(fields: [clinicalEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Matchmaking ──────────────────────────────────────────────────────────────

model CompatibilityTest {
  id                 String   @id @default(uuid())
  adopterId          String   @unique
  housingType        String
  hasYard            Boolean  @default(false)
  childrenCount      Int      @default(0)
  hasOtherPets       Boolean  @default(false)
  dailyAvailableTime Int
  allergies          String?
  experienceLevel    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  adopter User @relation(fields: [adopterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CompatibilityScore {
  id              String   @id @default(uuid())
  adopterId       String
  animalId        String
  scorePercentage Float
  explanation     String?
  calculatedAt    DateTime @default(now())

  adopter User   @relation(fields: [adopterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  animal  Animal @relation(fields: [animalId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([adopterId, animalId])
}

// ─── Adopción ─────────────────────────────────────────────────────────────────

model AdoptionRequest {
  id              String   @id @default(uuid())
  adopterId       String
  animalId        String
  /// Valores: RECEIVED | INTERVIEW | VISIT | APPROVED | REJECTED
  status          String   @default("RECEIVED")
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  adopter       User              @relation(fields: [adopterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  animal        Animal            @relation(fields: [animalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents     AdopterDocument[]
  contract      AdoptionContract?
  interviewSlot InterviewSlot?    @relation("SlotReservation")
}

model InterviewSlot {
  id                      String   @id @default(uuid())
  startsAt                DateTime
  endsAt                  DateTime
  /// Valores: available | reserved | cancelled
  status                  String   @default("available")
  reservedByApplicationId String?  @unique
  createdByAdminId        String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  createdBy   User             @relation(fields: [createdByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application AdoptionRequest? @relation("SlotReservation", fields: [reservedByApplicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AdopterDocument {
  id           String   @id @default(uuid())
  adopterId    String
  applicationId String?
  /// Valores: ID_CARD | ADDRESS_PROOF
  documentType String
  fileUrl      String
  fileName     String
  version      Int      @default(1)
  /// Valores: ACTIVE | ARCHIVED
  status       String   @default("ACTIVE")
  uploadedAt   DateTime @default(now())

  adopter     User             @relation(fields: [adopterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application AdoptionRequest? @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AdoptionContract {
  id            String   @id @default(uuid())
  applicationId String   @unique
  animalId      String?
  adopterId     String?
  pdfUrl        String?
  signedPdfUrl  String?
  signatureImageUrl String?
  /// Valores: GENERATED | SIGNED
  status        String   @default("GENERATED")
  createdAt     DateTime @default(now())
  signedAt      DateTime?

  application AdoptionRequest @relation(fields: [applicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Notificaciones ───────────────────────────────────────────────────────────

model Notification {
  id           String    @id @default(uuid())
  userId       String
  /// Valores: INFO | WARNING | SUCCESS | ERROR
  type         String
  title        String
  message      String
  resourceType String?
  resourceId   String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Tareas operativas ────────────────────────────────────────────────────────

model OperationalTask {
  id            String    @id @default(uuid())
  animalId      String?
  /// Valores: HEALTH | MEDICATION | CLEANING | FEEDING | MAINTENANCE
  type          String
  /// Valores: VETERINARIAN | VOLUNTEER
  assignedRole  String
  scheduledAt   DateTime
  /// Valores: PENDING | COMPLETED
  status        String    @default("PENDING")
  description   String?
  completedAt   DateTime?
  completedById String?
  comment       String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  animal      Animal? @relation(fields: [animalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  completedBy User?   @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Historial de localización ────────────────────────────────────────────────

model AnimalRescueLocationHistory {
  id              String   @id @default(uuid())
  animalId        String
  locationText    String?
  latitude        Float?
  longitude       Float?
  changedByUserId String
  createdAt       DateTime @default(now())

  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedBy User   @relation(fields: [changedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Auditoría ────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  entityType   String
  entityId     String
  metadataJson String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
