# SQL Server — Windows Authentication (recomendado en desarrollo local)
DATABASE_URL="sqlserver://localhost:1433;database=rescue_pet;integratedSecurity=true;trustServerCertificate=true"

# SQL Server — SQL Authentication (usuario y contraseña)
# DATABASE_URL="sqlserver://localhost:1433;database=rescue_pet;user=sa;password=TuPassword123!;trustServerCertificate=true"

# Named Instance (si usas SQL Server Express con nombre de instancia)
# DATABASE_URL="sqlserver://localhost\\SQLEXPRESS;database=rescue_pet;integratedSecurity=true;trustServerCertificate=true"

JWT_SECRET="cambia-esta-clave-en-produccion"
PORT=3000
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"
NODE_ENV=development

# SMTP — Dejar vacío en desarrollo; el sistema imprimirá los enlaces en consola
# Para producción usa un proveedor SMTP real (SendGrid, Resend, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rescue Pet <noreply@rescuepet.com>"
