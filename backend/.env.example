# ─── Base de datos ────────────────────────────────────────────────────────────
# Formato SQL Server para Prisma 6.x: semicolons (;) como separadores JDBC.
# El motor Rust de Prisma usa este formato en todas las versiones.
#
# Si ves el error "must start with protocol prisma://", el problema NO es el
# formato de la URL — es que DATABASE_URL está mal definida en las variables
# de entorno del sistema Windows. El servidor carga .env con override:true
# para garantizar que este archivo siempre prevalece.

# ── Instancia por defecto — Windows Authentication (recomendado en desarrollo)
DATABASE_URL="sqlserver://localhost:1433;database=rescue_pet;integratedSecurity=true;trustServerCertificate=true"

# ── SQL Authentication (usuario y contraseña explícitos)
# DATABASE_URL="sqlserver://localhost:1433;database=rescue_pet;user=sa;password=TuPassword123!;trustServerCertificate=true"

# ── Named Instance — SQL Server Express
# DATABASE_URL="sqlserver://localhost\\SQLEXPRESS;database=rescue_pet;integratedSecurity=true;trustServerCertificate=true"

# ── Puerto personalizado
# DATABASE_URL="sqlserver://localhost:1434;database=rescue_pet;integratedSecurity=true;trustServerCertificate=true"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="cambia-esta-clave-en-produccion"

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"
NODE_ENV=development

# ─── SMTP ────────────────────────────────────────────────────────────────────
# Vacío en desarrollo — los enlaces de activación/reset se imprimen en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rescue Pet <noreply@rescuepet.com>"
