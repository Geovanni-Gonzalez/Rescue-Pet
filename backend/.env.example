# Datos locales / persistentes
# Por defecto el backend guarda datos en backend/data/db.json.
# Usa JSON_DATA_DIR si quieres otro directorio local persistente.
JSON_DATA_DIR=

# En Vercel, conecta Vercel Blob para persistir db.json y uploads.
# El Marketplace inyecta BLOB_READ_WRITE_TOKEN automaticamente.
BLOB_READ_WRITE_TOKEN=
JSON_BLOB_PATH="rescue-pet/db.json"

# JWT
JWT_SECRET="cambia-esta-clave-en-produccion"

# Servidor
PORT=3000
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"
NODE_ENV=development

# SMTP
# Vacio en desarrollo: los enlaces de activacion/reset se imprimen en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rescue Pet <noreply@rescuepet.com>"
